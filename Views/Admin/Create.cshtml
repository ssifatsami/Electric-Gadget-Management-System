@model ElectricGadget.Web.Models.ViewModels.ProductCreateViewModel

@{
    ViewData["Title"] = "Add New Product";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add New Electric Gadget</h3>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">Product Name</label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Galaxy S24" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="BrandId" class="form-label fw-bold">Brand</label>
                                <select asp-for="BrandId" asp-items="Model.Brands" class="form-select form-select-lg" required>
                                    <option value="">-- Select Brand --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="CategoryId" class="form-label fw-bold">Dashboard Category</label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select form-select-lg" required>
                                    <option value="">-- Select Category --</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Price (৳)</label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label fw-bold">Stock Quantity</label>
                                <input asp-for="Stock" type="number" class="form-control form-control-lg" placeholder="10" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Model" class="form-label fw-bold">Model Name</label>
                                <input asp-for="Model" class="form-control" placeholder="e.g. S24 Ultra" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Warranty" class="form-label fw-bold">Warranty</label>
                                <input asp-for="Warranty" class="form-control" placeholder="e.g. 1 Year" />
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedSwitch">
                            <label class="form-check-label fw-bold" for="isPublishedSwitch">Publish to Customer Dashboard</label>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                            <div class="form-text">Leave blank to use default image.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed product description..."></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow">Save Product</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #1089ff;
        box-shadow: 0 0 0 0.25rem rgba(16, 137, 255, 0.25);
    }
</style>
