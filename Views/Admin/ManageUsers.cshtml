@model IEnumerable<ElectricGadget.Web.Models.Entities.User>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Management (Super Admin)</h2>
    </div>

    <table class="table table-striped shadow-sm">
        <thead class="bg-dark text-white">
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserID</td>
                    <td>@user.Name</td>
                    <td>@user.Email</td>
                    <td><span class="badge @(user.Role == "Super Admin" ? "bg-danger" : "bg-primary")">@user.Role</span></td>
                    <td>
                        @if (user.UserID != "superadmin")
                        {
                            <form asp-action="DeleteUser" asp-route-id="@user.UserID" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
