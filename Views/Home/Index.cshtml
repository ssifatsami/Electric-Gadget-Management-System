@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-white text-center py-5 mb-5" style="background: linear-gradient(135deg, #1089ff 0%, #23374d 100%);">
    <div class="container py-5">
        <h1 class="display-3 fw-bold mb-3">The Future of Tech is Here</h1>
        <p class="lead mb-4">Discover the latest premium electric gadgets with unbeatable prices and smart comparisons.</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg px-5 rounded-pill fw-bold text-primary">Shop Now</a>
            <a asp-controller="Product" asp-action="TopSelling" class="btn btn-outline-light btn-lg px-5 rounded-pill fw-bold">Best Sellers</a>
        </div>
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        <div class="col-md-4">
            <div class="p-4 shadow-sm rounded bg-white h-100">
                <i class="bi bi-truck fs-1 text-primary mb-3"></i>
                <h4>Fast Delivery</h4>
                <p class="text-muted">Get your gadgets delivered to your doorstep within 24 hours.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 shadow-sm rounded bg-white h-100">
                <i class="bi bi-shield-check fs-1 text-primary mb-3"></i>
                <h4>Secure Payments</h4>
                <p class="text-muted">100% secure payment gateways with multiple payment options.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 shadow-sm rounded bg-white h-100">
                <i class="bi bi-arrow-repeat fs-1 text-primary mb-3"></i>
                <h4>Easy Returns</h4>
                <p class="text-muted">Not satisfied? Return your product within 7 days for a full refund.</p>
            </div>
        </div>
    </div>

    <!-- Featured Categories Section -->
    <div class="section-title text-center mb-4">
        <h2 class="fw-bold">Browse by Category</h2>
        <p class="text-muted">Explore our wide range of electric categories</p>
    </div>
    <div class="row g-3 justify-content-center mb-5">
        @{
            string[] cats = { "Smartphone", "Laptop", "Smart TV", "Headphones", "Speaker", "Smart Watch" };
            string[] icons = { "phone", "laptop", "tv", "headphones", "volume-up", "watch" };
        }
        @for (int i = 0; i < cats.Length; i++)
        {
            <div class="col-6 col-md-2">
                <div class="card border-0 shadow-sm text-center p-3 h-100 category-card">
                    <i class="bi bi-@icons[i] fs-2 text-primary mb-2"></i>
                    <h6 class="mb-0">@cats[i]</h6>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .category-card { cursor: pointer; transition: 0.3s; }
    .category-card:hover { background-color: #1089ff; color: white; }
    .category-card:hover i { color: white !important; }
</style>
