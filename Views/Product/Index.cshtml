@model IEnumerable<ElectricGadget.Web.Models.Entities.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <div class="row">
        <!-- Filter Sidebar -->
        <div class="col-md-3">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filter Products</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="get">
                        <div class="mb-3">
                            <label class="form-label">Min Price</label>
                            <input type="number" name="minPrice" class="form-control" placeholder="0" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Max Price</label>
                            <input type="number" name="maxPrice" class="form-control" placeholder="5000" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Min Rating</label>
                            <select name="minRating" class="form-select">
                                <option value="">All Ratings</option>
                                <option value="4">4+ Stars</option>
                                <option value="3">3+ Stars</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Our Collection</h2>
                <div class="position-relative" style="width: 300px;">
                    <input type="text" id="searchInput" class="form-control" placeholder="Search gadgets..." autocomplete="off" />
                    <div id="searchSuggestions" class="list-group position-absolute w-100 shadow" style="z-index: 1000; display: none;"></div>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 product-card position-relative">
                            @if (item.IsOnSale)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">SALE</span>
                            }
                            <img src="@item.ImageUrl" class="card-img-top p-3" alt="@item.Name" style="height: 200px; object-fit: contain;">
                            <div class="card-body text-center">
                                <h5 class="card-title text-truncate">@item.Name</h5>
                                <p class="text-muted small mb-1">@item.Brand.Name</p>
                                <div class="mb-2 text-warning">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="bi bi-star@(i < Math.Round(item.AverageRating) ? "-fill" : "")"></i>
                                    }
                                    <span class="text-dark">(@item.AverageRating.ToString("0.0"))</span>
                                </div>
                                <div class="d-flex justify-content-center align-items-baseline gap-2">
                                    @if (item.IsOnSale)
                                    {
                                        <h4 class="text-danger">৳@item.DiscountPrice</h4>
                                        <h6 class="text-muted text-decoration-line-through">৳@item.Price</h6>
                                    }
                                    else
                                    {
                                        <h4 class="text-primary">৳@item.Price</h4>
                                    }
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addToCompare(@item.Id)">Compare</button>
                                    <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@item.Id" class="btn btn-primary btn-sm rounded-pill px-3">Add to Cart</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#searchInput').on('input', function() {
                let query = $(this).val();
                if (query.length < 2) {
                    $('#searchSuggestions').hide();
                    return;
                }

                $.get('/Product/SearchSuggestions', { q: query }, function(data) {
                    let html = '';
                    data.forEach(item => {
                        html += `<a href="/Product/Details/${item.id}" class="list-group-item list-group-item-action">
                                    <strong>${item.name}</strong> <span class="text-muted small">(${item.brand})</span>
                                 </a>`;
                    });
                    if (data.length > 0) {
                        $('#searchSuggestions').html(html).show();
                    } else {
                        $('#searchSuggestions').hide();
                    }
                });
            });

            $(document).click(function(e) {
                if (!$(e.target).closest('#searchInput, #searchSuggestions').length) {
                    $('#searchSuggestions').hide();
                }
            });
        });

        let compareList = [];
        function addToCompare(id) {
            if (!compareList.includes(id)) {
                compareList.push(id);
                if (compareList.length >= 2) {
                    window.location.href = '/Product/Compare?ids=' + compareList.join(',');
                } else {
                    alert("Select one more product to compare!");
                }
            }
        }
    </script>
}

<style>
    .product-card { transition: transform 0.2s; }
    .product-card:hover { transform: translateY(-5px); }
</style>
