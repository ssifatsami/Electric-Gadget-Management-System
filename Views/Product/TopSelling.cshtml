@model IEnumerable<ElectricGadget.Web.Models.Entities.Product>

@{
    ViewData["Title"] = "Top Selling Products";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Best Sellers</h1>
        <p class="lead text-muted">The most popular gadgets chosen by our customers this month.</p>
    </div>

    <div class="row g-4">
        @foreach (var (item, index) in Model.Select((value, i) => (value, i)))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow border-0 position-relative">
                    <span class="position-absolute top-0 start-0 badge bg-danger fs-5 m-2 shadow">
                        #@(index + 1)
                    </span>
                    <img src="@item.ImageUrl" class="card-img-top p-4" alt="@item.Name" style="height: 250px; object-fit: contain;">
                    <div class="card-body text-center">
                        <h5 class="card-title fw-bold">@item.Name</h5>
                        <p class="text-muted small">@item.Brand.Name | @item.Brand.Category.Name</p>
                        <div class="mb-3 text-warning">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="bi bi-star@(i < Math.Round(item.AverageRating) ? "-fill" : "")"></i>
                            }
                            <span class="text-dark fw-bold ms-1">@item.AverageRating.ToString("0.0")</span>
                        </div>
                        <h3 class="text-primary mb-3">৳@item.Price</h3>
                        <a href="/Product/Details/@item.Id" class="btn btn-primary rounded-pill px-4">View Product</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
