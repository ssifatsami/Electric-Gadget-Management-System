@model IEnumerable<ElectricGadget.Web.Models.Entities.Branch>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Branch Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1" style="font-weight:700;">Branch Management</h5>
        <p style="color:var(--sa-muted);font-size:0.85rem;margin:0;">Add, manage and monitor all branches</p>
    </div>
    <button class="sa-btn sa-btn-primary" data-bs-toggle="modal" data-bs-target="#addBranchModal">
        <i class="bi bi-plus-lg"></i> Add Branch
    </button>
</div>

<div class="row g-4">
    @foreach (var branch in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="sa-card h-100">
                <div class="sa-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 style="font-weight:700;margin:0;">@branch.Name</h6>
                            <p style="color:var(--sa-muted);font-size:0.8rem;margin:4px 0 0;">
                                <i class="bi bi-geo-alt-fill"></i> @(branch.Location ?? "No location set")
                            </p>
                        </div>
                        @if (branch.IsActive)
                        {
                            <span class="sa-badge sa-badge-success">Active</span>
                        }
                        else
                        {
                            <span class="sa-badge sa-badge-danger">Inactive</span>
                        }
                    </div>

                    <div style="background:rgba(99,102,241,0.06);border-radius:8px;padding:12px;margin-bottom:16px;">
                        <div style="font-size:0.75rem;color:var(--sa-muted);">Branch Manager</div>
                        <div style="font-size:0.85rem;font-weight:500;margin-top:2px;">
                            @(branch.Manager?.Name ?? "— Not Assigned —")
                        </div>
                    </div>

                    <div style="font-size:0.72rem;color:var(--sa-muted);margin-bottom:14px;">
                        <i class="bi bi-calendar3"></i> Created @branch.CreatedAt.ToString("dd MMM yyyy")
                    </div>

                    <div class="d-flex gap-2">
                        <form method="post" action="/SuperAdmin/ToggleBranch" style="flex:1;">
                            <input type="hidden" name="id" value="@branch.Id" />
                            <button type="submit" class="sa-btn @(branch.IsActive ? "sa-btn-warning" : "sa-btn-success") w-100 justify-content-center" style="font-size:0.78rem;">
                                <i class="bi @(branch.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                @(branch.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        <form method="post" action="/SuperAdmin/DeleteBranch"
                              onsubmit="return confirm('Delete branch @branch.Name?');">
                            <input type="hidden" name="id" value="@branch.Id" />
                            <button type="submit" class="sa-btn sa-btn-danger" style="padding:8px 14px;">
                                <i class="bi bi-trash-fill"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="sa-card text-center" style="padding:48px;">
                <i class="bi bi-diagram-3" style="font-size:3rem;color:var(--sa-muted);opacity:.4;"></i>
                <p class="mt-3" style="color:var(--sa-muted);">No branches added yet.</p>
            </div>
        </div>
    }
</div>

<!-- Add Branch Modal -->
<div class="modal fade" id="addBranchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:var(--sa-card);border:1px solid var(--sa-border);border-radius:16px;color:var(--sa-text);">
            <div class="modal-header" style="border-bottom:1px solid var(--sa-border);">
                <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle-fill" style="color:#6366f1;"></i> Add New Branch</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" action="/SuperAdmin/CreateBranch">
                <div class="modal-body">
                    <div class="sa-form-group">
                        <label class="sa-form-label">Branch Name *</label>
                        <input type="text" name="name" class="sa-form-control" placeholder="e.g. Sylhet Branch" required />
                    </div>
                    <div class="sa-form-group">
                        <label class="sa-form-label">Location</label>
                        <input type="text" name="location" class="sa-form-control" placeholder="e.g. Sylhet, Bangladesh" />
                    </div>
                    <div class="sa-form-group mb-0">
                        <label class="sa-form-label">Manager (optional)</label>
                        <input type="text" name="managerId" class="sa-form-control" placeholder="Admin UserID" />
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--sa-border);">
                    <button type="button" class="sa-btn sa-btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="sa-btn sa-btn-primary"><i class="bi bi-check-lg"></i> Create Branch</button>
                </div>
            </form>
        </div>
    </div>
</div>
