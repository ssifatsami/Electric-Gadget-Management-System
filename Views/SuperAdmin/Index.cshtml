@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Super Admin Dashboard";
}

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="sa-stat">
            <div class="sa-stat-icon" style="background:rgba(99,102,241,0.15);">
                <i class="bi bi-box-seam-fill" style="color:#6366f1;"></i>
            </div>
            <div>
                <div class="sa-stat-value">@ViewBag.TotalGadgets</div>
                <div class="sa-stat-label">Total Gadgets</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="sa-stat">
            <div class="sa-stat-icon" style="background:rgba(16,185,129,0.15);">
                <i class="bi bi-people-fill" style="color:#10b981;"></i>
            </div>
            <div>
                <div class="sa-stat-value">@ViewBag.TotalUsers</div>
                <div class="sa-stat-label">Total Customers</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="sa-stat">
            <div class="sa-stat-icon" style="background:rgba(59,130,246,0.15);">
                <i class="bi bi-shield-person-fill" style="color:#3b82f6;"></i>
            </div>
            <div>
                <div class="sa-stat-value">@ViewBag.TotalAdmins</div>
                <div class="sa-stat-label">System Admins</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="sa-stat" style="border-left: 4px solid var(--sa-success);">
            <div class="sa-stat-icon" style="background:rgba(16,185,129,0.15);">
                <i class="bi bi-currency-exchange" style="color:#10b981;"></i>
            </div>
            <div>
                <div class="sa-stat-value">৳@String.Format("{0:N0}", ViewBag.TotalRevenue)</div>
                <div class="sa-stat-label">Total Revenue</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Analytics Chart -->
    <div class="col-lg-8">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <i class="bi bi-activity" style="color:#6366f1;"></i> System Audit Activity
            </div>
            <div class="sa-card-body">
                <canvas id="performanceChart" height="250"></canvas>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4">
        <div class="sa-card h-100">
            <div class="sa-card-header">
                <i class="bi bi-lightning-fill" style="color:#f59e0b;"></i> Quick Controls
            </div>
            <div class="sa-card-body d-flex flex-column gap-3">
                <a href="/SuperAdmin/CreateAdmin" class="sa-btn sa-btn-primary w-100 justify-content-center py-3">
                    <i class="bi bi-person-plus-fill"></i> Add New Admin
                </a>
                <div class="d-grid grid-template-columns: 1fr 1fr; gap: 12px; display: grid;">
                    <a href="/SuperAdmin/Branches" class="sa-btn sa-btn-ghost justify-content-center py-3">
                        <i class="bi bi-diagram-3-fill"></i> Branches
                    </a>
                    <a href="/SuperAdmin/Permissions" class="sa-btn sa-btn-ghost justify-content-center py-3">
                        <i class="bi bi-key-fill"></i> Permissions
                    </a>
                </div>
                <a href="/SuperAdmin/Backup" class="sa-btn sa-btn-ghost w-100 justify-content-center py-3">
                    <i class="bi bi-cloud-arrow-up-fill"></i> System Backup
                </a>
                <a href="/SuperAdmin/Settings" class="sa-btn sa-btn-ghost w-100 justify-content-center py-3">
                    <i class="bi bi-gear-fill"></i> Global Settings
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Activity -->
    <div class="col-lg-12">
        <div class="sa-card">
            <div class="sa-card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-journal-text" style="color:#6366f1;"></i> System Audit Logs</span>
                <a href="/SuperAdmin/AuditLogs" class="sa-btn sa-btn-ghost" style="padding:4px 12px;font-size:0.75rem;">View Detailed Logs</a>
            </div>
            <div class="table-responsive">
                @if (ViewBag.RecentLogs != null && ((IEnumerable<dynamic>)ViewBag.RecentLogs).Any())
                {
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Module</th>
                                <th>Details</th>
                                <th>Performed By</th>
                                <th>IP Address</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in ViewBag.RecentLogs)
                            {
                                <tr>
                                    <td>
                                        @{
                                            var badgeClass = log.Action == "Delete" ? "sa-badge-danger"
                                                           : log.Action == "Create" ? "sa-badge-success"
                                                           : log.Action == "Update" ? "sa-badge-warning"
                                                           : "sa-badge-info";
                                        }
                                        <span class="sa-badge @badgeClass">@log.Action</span>
                                    </td>
                                    <td><span class="sa-badge sa-badge-accent">@log.Module</span></td>
                                    <td style="color:var(--sa-text);font-size:0.85rem;">@log.Details</td>
                                    <td>
                                        <div style="font-weight:600;font-size:0.85rem;">@log.UserName</div>
                                        <div style="font-size:0.7rem;color:var(--sa-muted);">@log.UserId</div>
                                    </td>
                                    <td style="color:var(--sa-muted);font-size:0.8rem;">@(log.IpAddress ?? "—")</td>
                                    <td style="color:var(--sa-muted);font-size:0.8rem;">@log.Timestamp.ToString("dd MMM, HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5" style="color:var(--sa-muted);">
                        <i class="bi bi-journal-x" style="font-size:3rem;opacity:.2;"></i>
                        <p class="mt-3">No system logs recorded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const ctx = document.getElementById('performanceChart').getContext('2d');
    
    // Gradient for chart
    let gradient = ctx.createLinearGradient(0, 0, 0, 400);
    gradient.addColorStop(0, 'rgba(99, 102, 241, 0.4)');
    gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
            datasets: [{
                label: 'System Activity',
                data: @Html.Raw(Json.Serialize(ViewBag.ChartData)),
                borderColor: '#6366f1',
                backgroundColor: gradient,
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#6366f1',
                borderWidth: 3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255, 255, 255, 0.05)' },
                    ticks: { 
                        color: '#64748b', 
                        font: { size: 10 },
                        stepSize: 1 // Since these are counts
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#64748b', font: { size: 10 } }
                }
            }
        }
    });
</script>
}

