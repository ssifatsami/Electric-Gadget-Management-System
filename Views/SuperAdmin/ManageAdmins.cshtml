@model IEnumerable<ElectricGadget.Web.Models.Entities.User>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Manage Admins";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1" style="font-weight:700;">Admin Accounts</h5>
        <p style="color:var(--sa-muted);font-size:0.85rem;margin:0;">Create, edit, suspend or delete admin users</p>
    </div>
    <a href="/SuperAdmin/CreateAdmin" class="sa-btn sa-btn-primary">
        <i class="bi bi-person-plus-fill"></i> New Admin
    </a>
</div>

<div class="sa-card">
    @if (Model.Any())
    {
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Admin</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div class="sa-avatar" style="width:34px;height:34px;font-size:0.75rem;">
                                    @admin.Name.Substring(0,1).ToUpper()
                                </div>
                                <span style="font-weight:500;">@admin.Name</span>
                            </div>
                        </td>
                        <td><code style="color:var(--sa-accent);background:rgba(99,102,241,0.08);padding:3px 8px;border-radius:5px;">@admin.UserID</code></td>
                        <td style="color:var(--sa-muted);font-size:0.82rem;">@(admin.Email ?? "—")</td>
                        <td style="font-size:0.82rem;">@(admin.Branch?.Name ?? "—")</td>
                        <td>
                            @if (admin.IsActive)
                            {
                                <span class="sa-badge sa-badge-success"><i class="bi bi-circle-fill" style="font-size:6px;"></i> Active</span>
                            }
                            else
                            {
                                <span class="sa-badge sa-badge-danger"><i class="bi bi-circle-fill" style="font-size:6px;"></i> Suspended</span>
                            }
                        </td>
                        <td style="color:var(--sa-muted);font-size:0.8rem;">@admin.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right;">
                            <div style="display:flex;gap:6px;justify-content:flex-end;">
                                <a href="/SuperAdmin/EditAdmin/@admin.UserID" class="sa-btn sa-btn-ghost" style="padding:5px 12px;">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form method="post" action="/SuperAdmin/ToggleAdminStatus" style="display:inline;">
                                    <input type="hidden" name="id" value="@admin.UserID" />
                                    <button type="submit" class="sa-btn @(admin.IsActive ? "sa-btn-warning" : "sa-btn-success")" style="padding:5px 12px;">
                                        <i class="bi @(admin.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                    </button>
                                </form>
                                <form method="post" action="/SuperAdmin/DeleteAdmin"
                                      onsubmit="return confirm('Delete admin @admin.UserID? This cannot be undone.');" style="display:inline;">
                                    <input type="hidden" name="id" value="@admin.UserID" />
                                    <button type="submit" class="sa-btn sa-btn-danger" style="padding:5px 12px;">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5" style="color:var(--sa-muted);">
            <i class="bi bi-person-slash" style="font-size:3rem;opacity:.3;"></i>
            <p class="mt-3">No admin accounts yet.</p>
            <a href="/SuperAdmin/CreateAdmin" class="sa-btn sa-btn-primary">
                <i class="bi bi-person-plus-fill"></i> Create First Admin
            </a>
        </div>
    }
</div>
