@model IEnumerable<ElectricGadget.Web.Models.Entities.User>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Manage Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="mb-1" style="font-weight:700;">Customer Management</h5>
        <p style="color:var(--sa-muted);font-size:0.85rem;margin:0;">View and manage customer accounts</p>
    </div>
</div>

<div class="sa-card">
    @if (Model.Any())
    {
        <table class="sa-table">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:10px;">
                                <div class="sa-avatar" style="width:34px;height:34px;font-size:0.75rem;background:#3b82f6;">
                                    @user.Name.Substring(0,1).ToUpper()
                                </div>
                                <span style="font-weight:500;">@user.Name</span>
                            </div>
                        </td>
                        <td><code style="color:var(--sa-info);background:rgba(59,130,246,0.08);padding:3px 8px;border-radius:5px;">@user.UserID</code></td>
                        <td style="color:var(--sa-muted);font-size:0.82rem;">@(user.Email ?? "—")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="sa-badge sa-badge-success"><i class="bi bi-circle-fill" style="font-size:6px;"></i> Active</span>
                            }
                            else
                            {
                                <span class="sa-badge sa-badge-danger"><i class="bi bi-circle-fill" style="font-size:6px;"></i> Suspended</span>
                            }
                        </td>
                        <td style="color:var(--sa-muted);font-size:0.8rem;">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right;">
                            <div style="display:flex;gap:6px;justify-content:flex-end;">
                                <form method="post" action="/SuperAdmin/ToggleUserStatus" style="display:inline;">
                                    <input type="hidden" name="id" value="@user.UserID" />
                                    <button type="submit" class="sa-btn @(user.IsActive ? "sa-btn-warning" : "sa-btn-success")" style="padding:5px 12px;">
                                        <i class="bi @(user.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        @(user.IsActive ? "Suspend" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-center py-5" style="color:var(--sa-muted);">
            <i class="bi bi-people" style="font-size:3rem;opacity:.3;"></i>
            <p class="mt-3">No customers found.</p>
        </div>
    }
</div>
