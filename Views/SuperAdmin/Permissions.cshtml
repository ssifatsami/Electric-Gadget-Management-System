@model IEnumerable<ElectricGadget.Web.Models.Entities.User>
@{
    Layout = "~/Views/SuperAdmin/_SuperAdminLayout.cshtml";
    ViewData["Title"] = "Permission Control";
}

<div class="mb-4">
    <h5 style="font-weight:700;margin:0;">Permission Control</h5>
    <p style="color:var(--sa-muted);font-size:0.85rem;margin:4px 0 0;">Control what each admin can access</p>
</div>

@foreach (var admin in Model)
{
    <div class="sa-card mb-4">
        <div class="sa-card-header" style="justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div class="sa-avatar">@admin.Name.Substring(0,1).ToUpper()</div>
                <div>
                    <div style="font-weight:600;">@admin.Name</div>
                    <div style="font-size:0.75rem;color:var(--sa-muted);">@admin.UserID</div>
                </div>
            </div>
            <span class="sa-badge @(admin.IsActive ? "sa-badge-success" : "sa-badge-danger")">
                @(admin.IsActive ? "Active" : "Suspended")
            </span>
        </div>
        <div class="sa-card-body">
            <form method="post" action="/SuperAdmin/SavePermissions">
                <input type="hidden" name="userId" value="@admin.UserID" />
                <div class="row g-3">
                    <div class="col-md-3 col-sm-6">
                        <div style="background:rgba(16,185,129,0.06);border:1px solid rgba(16,185,129,0.15);border-radius:10px;padding:16px;text-align:center;">
                            <label class="sa-switch" style="margin:0 auto 10px;">
                                <input type="checkbox" name="canInventory" value="true" checked="@admin.CanAccessInventory" />
                                <span class="sa-switch-slider"></span>
                            </label>
                            <div style="font-size:0.82rem;font-weight:600;">Inventory</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div style="background:rgba(59,130,246,0.06);border:1px solid rgba(59,130,246,0.15);border-radius:10px;padding:16px;text-align:center;">
                            <label class="sa-switch" style="margin:0 auto 10px;">
                                <input type="checkbox" name="canBilling" value="true" checked="@admin.CanAccessBilling" />
                                <span class="sa-switch-slider"></span>
                            </label>
                            <div style="font-size:0.82rem;font-weight:600;">Billing</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div style="background:rgba(245,158,11,0.06);border:1px solid rgba(245,158,11,0.15);border-radius:10px;padding:16px;text-align:center;">
                            <label class="sa-switch" style="margin:0 auto 10px;">
                                <input type="checkbox" name="canReports" value="true" checked="@admin.CanDownloadReports" />
                                <span class="sa-switch-slider"></span>
                            </label>
                            <div style="font-size:0.82rem;font-weight:600;">Reports</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div style="background:rgba(239,68,68,0.06);border:1px solid rgba(239,68,68,0.15);border-radius:10px;padding:16px;text-align:center;">
                            <label class="sa-switch" style="margin:0 auto 10px;">
                                <input type="checkbox" name="canUsers" value="true" checked="@admin.CanManageUsers" />
                                <span class="sa-switch-slider"></span>
                            </label>
                            <div style="font-size:0.82rem;font-weight:600;">Users</div>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button type="submit" class="sa-btn sa-btn-primary">
                        <i class="bi bi-check-lg"></i> Save for @admin.Name
                    </button>
                </div>
            </form>
        </div>
    </div>
}
@if (!Model.Any())
{
    <div class="sa-card text-center" style="padding:48px;">
        <i class="bi bi-key" style="font-size:3rem;opacity:.3;"></i>
        <p class="mt-3" style="color:var(--sa-muted);">No admins to configure.</p>
        <a href="/SuperAdmin/CreateAdmin" class="sa-btn sa-btn-primary">Create First Admin</a>
    </div>
}
